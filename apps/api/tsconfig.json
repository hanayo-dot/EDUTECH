{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@chuoms/common": ["../../packages/common/src"],
      "@chuoms/database": ["../../packages/database/src"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
