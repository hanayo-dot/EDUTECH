{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@edutech/common$": "<rootDir>/../../../packages/common/src",
    "^@edutech/database$": "<rootDir>/../../../packages/database/src"
  }
}
