# ==============================================================================
# EduTech College Management System — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'test' | 'staging' | 'production')
NODE_ENV=development
APP_PORT=4000
WEB_PORT=3000

# Primary Relational Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5432
DB_USER=edutech_user
DB_PASSWORD=edutech_secure_password_2026
DB_NAME=edutech_cms
DATABASE_URL="postgresql://edutech_user:edutech_secure_password_2026@localhost:5432/edutech_cms?schema=public&connection_limit=20"

# Redis Cache, Session Invalidation & BullMQ Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=edutech_redis_password_2026

# JWT Authentication & Cryptographic Secrets
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_JWT_ACCESS_KEY_2026"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_SUPER_SECRET_JWT_REFRESH_KEY_2026"
JWT_REFRESH_EXPIRATION="7d"

# Argon2id Password Hashing Parameters
ARGON_MEMORY_COST=65536
ARGON_TIME_COST=3
ARGON_PARALLELISM=4

# S3-Compatible Object Storage (MinIO / AWS S3)
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=edutech_minio_admin
S3_SECRET_KEY=edutech_minio_secret_2026
S3_BUCKET_DOCUMENTS=edutech-documents
S3_BUCKET_PUBLIC=edutech-public

# Transactional Email (Mailpit in development, AWS SES/SendGrid in production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="EduTech Notifications <noreply@edutech.edu>"

# Institutional Default Settings
DEFAULT_TIMEZONE="UTC"
DEFAULT_CURRENCY="USD"
DEFAULT_DATE_FORMAT="YYYY-MM-DD"
MAX_FILE_SIZE_BYTES=10485760
